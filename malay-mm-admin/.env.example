# Backend URL for the Vite admin panel.
# Local backend:
VITE_API_URL=http://localhost:3000

# For a Cloudflare tunnel, replace the value above with its HTTPS URL:
# VITE_API_URL=https://your-tunnel.trycloudflare.com

# Optional: comma-separated browser origins allowed by the backend.
# CORS_ORIGIN=http://localhost:5173

# Server-only values. Store the real values only in the local .env file.
# Generate them securely and never commit a real secret.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD_HASH=$2b$12$replace_with_a_real_bcrypt_hash
SESSION_SECRET=replace_with_a_secure_random_value_of_at_least_32_characters
ADMIN_ORIGIN=http://localhost:5173
API_PORT=3000
WEBAUTHN_RP_ID=localhost
WEBAUTHN_RP_NAME=Sagawa Admin
SESSION_TTL_MS=28800000
WEBAUTHN_CHALLENGE_TTL_MS=300000
VERIFICATION_CODE_TTL_MS=300000

# Email configuration for verification codes and password reset
# SMTP host, port, and credentials must be configured for email delivery to work
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_SECURE=false
EMAIL_USER=your-email@gmail.com
EMAIL_PASSWORD=your-app-specific-password
EMAIL_FROM=noreply@sagawa-admin.local
