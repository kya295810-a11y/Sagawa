# Backend URL for the Vite admin panel.
# Local backend:
VITE_API_URL=http://localhost:3000

# For a Cloudflare tunnel, replace the value above with its HTTPS URL:
# VITE_API_URL=https://your-tunnel.trycloudflare.com

# Optional: comma-separated browser origins allowed by the backend.
# CORS_ORIGIN=http://localhost:5173

# Server-only values. Store the real values only in the local .env file.
# Generate them securely and never commit a real secret.
ADMIN_EMAIL=
ADMIN_NAME=Sagawa Admin
ADMIN_PASSWORD_HASH=
SESSION_SECRET=
ADMIN_ORIGIN=
NODE_ENV=
API_PORT=3000
# Set to the exact trusted proxy hop count only when deployed behind a proxy/tunnel.
TRUST_PROXY_HOPS=0
WEBAUTHN_RP_ID=localhost
WEBAUTHN_RP_NAME=Sagawa Admin
SESSION_TTL_MS=28800000
WEBAUTHN_CHALLENGE_TTL_MS=300000
VERIFICATION_CODE_TTL_MS=300000

# PostgreSQL connection
DB_HOST=localhost
DB_PORT=5432
DB_NAME=sagawa
DB_USER=postgres
DB_PASSWORD=replace_with_your_database_password

# Optional persistent directory for uploaded exchange-provider logos.
# Required in production when the host filesystem is ephemeral.
EXCHANGE_PROVIDER_UPLOAD_DIR=

# Email configuration for verification codes and password reset.
# Use a server-side Resend API key; never expose this value to the mobile app.
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
EMAIL_FROM=Sagawa <noreply@mail.example.com>

# SMS verification for Malaysia (+60) accounts only.
# Keep these server-side only. Phone signup/login stays unavailable until configured.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# Optional Google Sheets user sync (server-side only).
# Keep disabled until the service account has edit access to the spreadsheet.
GOOGLE_SHEETS_SYNC_ENABLED=false
GOOGLE_SHEETS_SPREADSHEET_ID=1JvTBJrvq_svel-tOW7FroEnnWZwJ6XSNDpEvQuWdaBk
GOOGLE_SHEETS_TAB_NAME=Users
GOOGLE_SHEETS_DATA_START_ROW=5
GOOGLE_SHEETS_TIMEOUT_MS=5000
GOOGLE_SHEETS_FLUSH_DELAY_MS=5000
GOOGLE_SHEETS_BATCH_SIZE=100
GOOGLE_SHEETS_MIN_USER_SYNC_INTERVAL_MS=300000
GOOGLE_SHEETS_CLIENT_EMAIL=
# Store the full service-account private key in the real .env / Render secret.
# On Render, use literal \n sequences if entering it as one line.
GOOGLE_SHEETS_PRIVATE_KEY=



# Optional Expo push access token. Only required when enhanced push security is enabled.
# Keep the real value in Render/local secrets, never in Git.
EXPO_ACCESS_TOKEN=
