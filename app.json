{
  "expo": {
    "name": "Sagawa",
    "slug": "sagawa",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/sagawa-icon.png",
    "scheme": "sagawa",
    "userInterfaceStyle": "light",
    "ios": {
      "bundleIdentifier": "com.kyawsanlin.sagawa"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/sagawa-icon.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.kyawsanlin.sagawa",
      "googleServicesFile": "./google-services.json"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0B5FFF",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ],
      "expo-secure-store",
      "expo-localization",
      "expo-asset",
      "expo-image",
      [
        "expo-notifications",
        {
          "defaultChannel": "default"
        }
      ],
      "expo-video",
      "expo-web-browser"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "appOwnership": "foundation-shell",
      "router": {},
      "eas": {
        "projectId": "41a8c754-f8ae-412d-ab01-f7bb60580bd5"
      }
    },
    "owner": "kya295810s-team"
  }
}