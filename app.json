{
  "expo": {
    "name": "Sagawa",
    "slug": "sagawa",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/sagawa-icon.png",
    "scheme": "sagawa",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "com.kyawsanlin.sagawa"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/sagawa-icon.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.kyawsanlin.sagawa"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0B5FFF",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ],
      "expo-secure-store",
      "expo-localization",
      "expo-asset",
      "expo-image",
      "expo-notifications"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "appOwnership": "foundation-shell"
    }
  }
}
